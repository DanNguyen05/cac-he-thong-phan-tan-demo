# Public URLs only. Never place secrets in VITE_* variables.
# Default same-origin gateway (recommended):
VITE_API_URL=/api
# Optional full SSE endpoint; otherwise derived from VITE_API_URL:
# VITE_SSE_URL=https://lab.example.edu/api/events
# Dev proxy target (server-side Vite configuration):
LAB_API_URL=http://127.0.0.1:8000
