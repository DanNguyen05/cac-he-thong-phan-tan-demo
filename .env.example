# Reference only: Python does not auto-load this file.
# PowerShell: $env:LAB_PORT='8000'; python -m backend
# systemd: EnvironmentFile=/etc/fault-lab/backend.env
LAB_PORT=8000
LAB_DATA=./data
LAB_PACE=0.3
LAB_TIMEOUT=0.65
LAB_PUBLIC=false
LAB_ALLOW_PROCESS_CONTROL=false
# Explicit comma-separated browser origins, no wildcard:
# LAB_ALLOWED_ORIGINS=https://lab.example.edu
# Required in public mode: generate a unique secret of >=32 characters.
# LAB_GATEWAY_TOKEN=
# Optional internal callback token; generated per supervisor if absent.
# LAB_INTERNAL_TOKEN=
